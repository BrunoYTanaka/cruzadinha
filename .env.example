# Copie para .env e ajuste. Valores fictícios: nunca coloque segredos reais aqui.

# Servidor (apps/api)
DATABASE_URL=postgres://cruzadinha:cruzadinha@localhost:5432/cruzadinha
DB_PORT=55432
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Saltos de proxy confiáveis para descobrir o IP real (0 = não confiar no X-Forwarded-For)
TRUST_PROXY_HOPS=0
# Segredo do repasse do site (produção). Vazio = API aceita pedidos diretos, como no
# desenvolvimento. 32 a 256 caracteres. Em NODE_ENV=production o servidor não sobe sem ele.
PROXY_SECRET=
# Só para rodar a imagem de produção sem o repasse (o docker-compose.yml já define). Nunca no Render.
ALLOW_MISSING_PROXY_SECRET=
# SHA publicado, mostrado no /api/health; no Render vem de RENDER_GIT_COMMIT.
RELEASE_COMMIT=
# Cadastro aberto pelo site e pela API: só `true` ou `false`; vazio ou ausente vale `false`.
# Contas com o cadastro fechado: npm run cli -w @cruzadinha/api -- users create --email <email>
REGISTRATION_ENABLED=false

# Dias anteriores a hoje que "puzzles collect" também busca (0 = só o dia, máximo 365).
# O limite real de histórico da fonte é desconhecido: aumente aos poucos.
COLLECT_HISTORY_DAYS=31

# Seed de desenvolvimento (npm run db:seed)
# Valores fictícios, só para desenvolvimento; o seed recusa rodar em produção
SEED_USER_EMAIL=dev@cruzadinha.local
SEED_USER_PASSWORD=senha-de-teste-123

# Ambiente local (Docker Compose e Vite)
DB_PORT=5432
API_PORT=3000
API_PROXY_TARGET=http://localhost:3000

# Front (apps/web): limites das ajudas por cruzada. O Vite lê estas variáveis no build
# (mudar exige gerar o site de novo) e só expõe as que começam com VITE_. Sem segredos aqui.
VITE_HELP_LETTER_LIMIT=4
VITE_HELP_WORD_LIMIT=2
