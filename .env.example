# Copie para .env e ajuste. Valores fictícios: nunca coloque segredos reais aqui.

# Servidor (apps/api)
DATABASE_URL=postgres://cruzadinha:cruzadinha@localhost:5432/cruzadinha
DB_PORT=55432
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Saltos de proxy confiáveis para descobrir o IP real (0 = não confiar no X-Forwarded-For)
TRUST_PROXY_HOPS=0

# Seed de desenvolvimento (npm run db:seed)
# Valores fictícios, só para desenvolvimento; o seed recusa rodar em produção
SEED_USER_EMAIL=dev@cruzadinha.local
SEED_USER_PASSWORD=senha-de-teste-123

# Ambiente local (Docker Compose e Vite)
DB_PORT=5432
API_PORT=3000
API_PROXY_TARGET=http://localhost:3000
