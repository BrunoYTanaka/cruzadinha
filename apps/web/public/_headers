# Site sem divulgação em buscadores (constitution VIII): não indexar nem seguir links (feature 012,
# FR-007; feature 013, FR-025).
/*
  X-Robots-Tag: noindex, nofollow

# O HTML é sempre conferido, para uma aba nova não apontar para arquivos que deixaram de existir
# depois de uma publicação (FR-024).
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Versão publicada do site, lida pelo workflow de publicação (FR-023).
/version.json
  Cache-Control: no-store

# Os links de confirmação e de recuperação trazem o token no fragmento; sem origem enviada a outros
# sites (feature 035).
/verificar-email
  Referrer-Policy: no-referrer

/redefinir-senha
  Referrer-Policy: no-referrer

# O navegador sempre confere se há service worker ou manifesto novo (feature 041).
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
