# Só a landing (/) pode ser indexada (constitution VIII, emenda 5.0.0; feature 048): todas as outras
# páginas seguem sem indexação e sem seguir links (feature 012, FR-007; feature 013, FR-025). O
# `! X-Robots-Tag` tira o cabeçalho que o `/*` poria no endereço raiz e nos arquivos para buscadores.
/*
  X-Robots-Tag: noindex, nofollow

/sitemap.xml
  ! X-Robots-Tag

/robots.txt
  ! X-Robots-Tag

# O HTML é sempre conferido, para uma aba nova não apontar para arquivos que deixaram de existir
# depois de uma publicação (FR-024). O endereço raiz também é a landing indexável (feature 048).
/
  ! X-Robots-Tag
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Versão publicada do site, lida pelo workflow de publicação (FR-023).
/version.json
  Cache-Control: no-store

# Os links de confirmação e de recuperação trazem o token no fragmento; sem origem enviada a outros
# sites (feature 035).
/verificar-email
  Referrer-Policy: no-referrer

/redefinir-senha
  Referrer-Policy: no-referrer

# O navegador sempre confere se há service worker ou manifesto novo (feature 041).
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# O link de troca de e-mail também traz o token no fragmento (feature 042).
/confirmar-email
  Referrer-Policy: no-referrer
