{
  "name": "@cruzadinha/api",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsdown",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/platform/db/migrate.ts",
    "db:seed": "tsx src/seed/seed.ts",
    "cli": "tsx src/cli.ts",
    "source:check": "tsx src/sources/oglobo/check.ts",
    "source:check:cruzadaonline": "tsx src/sources/cruzadaonline/check.ts",
    "source:check:cruzadasbrasil": "tsx src/sources/cruzadasbrasil/check.ts",
    "source:check:clube": "tsx src/sources/clube/check.ts"
  },
  "dependencies": {
    "@cruzadinha/shared": "0.33.0",
    "@fastify/cookie": "11.1",
    "@fastify/swagger": "9.9",
    "@fastify/swagger-ui": "6.1",
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@node-rs/argon2": "2.2",
    "drizzle-orm": "0.45",
    "fast-xml-parser": "5.11",
    "fastify": "5.12",
    "fastify-plugin": "6.0",
    "postgres": "3.4",
    "quickjs-emscripten-core": "0.32.0",
    "zod": "4.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1",
    "@testcontainers/postgresql": "12.2",
    "@types/node": "^24.19.2",
    "drizzle-kit": "0.31",
    "tsdown": "^0.23.1",
    "tsx": "4.23",
    "vitest": "5.0"
  }
}
